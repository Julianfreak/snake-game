# ──────────────────────────────────────────────
# Contenedor de despliegue a AWS
# Incluye Node.js 22, AWS CLI v2 y AWS CDK
# No necesitas instalar nada en tu SO
# ──────────────────────────────────────────────
FROM node:22-slim

LABEL org.opencontainers.image.title="Snake Game - Deploy"
LABEL org.opencontainers.image.description="Contenedor con herramientas para desplegar el juego en AWS (CDK + AWS CLI)"

# Dependencias del sistema para AWS CLI
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Instalar AWS CLI v2
RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "/tmp/awscliv2.zip" \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/awscliv2.zip /tmp/aws

# Instalar AWS CDK globalmente
RUN npm install -g aws-cdk@2

# Directorio de trabajo
WORKDIR /app

# Copiar package.json primero (mejor caché de capas Docker)
COPY package.json package-lock.json ./
COPY aws-blocks/package.json ./aws-blocks/package.json

# Instalar dependencias del proyecto
RUN npm install

# Copiar el resto del proyecto
COPY . .

# Verificar que las herramientas están disponibles
RUN echo "node $(node --version)" \
    && echo "npm $(npm --version)" \
    && echo "aws $(aws --version)" \
    && echo "cdk $(cdk --version)"

# Shell interactivo por defecto (para ejecutar comandos de despliegue)
CMD ["bash"]
